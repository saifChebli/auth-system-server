      "boundElements": null,
      "updated": 1778615840745,
      "link": null,
      "locked": false,
      "text": "- With JWT (After login) : 1 / User logs in \n                                 2/ Server generates JWT\n                                 3/ Client stores token\n                                 4/ Client sends token with future requests\n\n====> Server can verify identity",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "- With JWT (After login) : 1 / User logs in \n                                 2/ Server generates JWT\n                                 3/ Client stores token\n                                 4/ Client sends token with future requests\n\n====> Server can verify identity",
      "autoResize": true,
      "lineHeight": 1.25
